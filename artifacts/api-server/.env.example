# ======================================================
# NOOR STORE - API SERVER ENVIRONMENT VARIABLES
# ======================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to GitHub

# PostgreSQL connection string (get this from neon.tech)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_host.neon.tech/noor?sslmode=require

# Secret string for admin session tokens (make up any random string)
SESSION_SECRET=change-this-to-any-random-secret-string

# Admin login credentials for /seller/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MH@Store2024

# Port the API server runs on
PORT=8080

# Set to "production" when deploying live
NODE_ENV=production

# Optional: Your frontend URL (for CORS in production)
# Example: https://noor-store.up.railway.app
FRONTEND_URL=

# Optional: Brave Search API key (for product image search in admin)
# Get free key at: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=

# Optional: Directory to store uploaded product images
# Default: ./uploads (inside the project root)
# For Railway persistence: mount a volume and set this to the mount path
UPLOADS_DIR=

# Optional: Your public URL (used to generate image upload URLs)
# Example: https://your-app.up.railway.app
PUBLIC_URL=
