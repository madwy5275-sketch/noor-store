# ======================================================
# NOOR STORE - FRONTEND ENVIRONMENT VARIABLES
# ======================================================
# Copy this file to .env and fill in your values

# Port the frontend dev server runs on
PORT=3000

# URL prefix — use / for root (default)
BASE_PATH=/

# API server URL (only needed when running frontend separately)
# Example: https://your-api.railway.app
API_URL=http://localhost:8080
